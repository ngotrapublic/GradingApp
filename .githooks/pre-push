#!/usr/bin/env python3
"""Bump app version once per push, commit it, then continue the push with the new commit."""
import os
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
BUMP = ROOT / 'tools' / 'bump_version.py'
MARKER = ROOT / '.git' / 'GRADING_VERSION_BUMPED'


def run(cmd):
    return subprocess.run(cmd, cwd=ROOT, check=True, capture_output=True, text=True)


def main():
    if MARKER.exists():
        MARKER.unlink(missing_ok=True)
        return 0
    new = run([sys.executable, str(BUMP)]).stdout.strip()
    run(['git', 'add', 'public/js/core/version.js'])
    run(['git', 'commit', '-m', f'Bump version to {new}.'])
    MARKER.write_text(new, encoding='utf-8')
    remote = sys.argv[1] if len(sys.argv) > 1 else 'origin'
    branch = run(['git', 'rev-parse', '--abbrev-ref', 'HEAD']).stdout.strip()
    os.execvp('git', ['git', 'push', remote, branch])


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as e:
        sys.stderr.write(e.stderr or str(e))
        raise SystemExit(e.returncode)
